            <script>
// OnEndMerge start ------------------------------------------------------
function OnEndMerge() {
var v = this._value;
v =      v.substring( 0, 2) + 
	&apos;  &apos; + v.substring( 2, 3) +
	&apos; &apos;  + v.substring( 3, 4) +
	&apos; &apos;  + v.substring( 4, 5) +
	&apos; &apos;  + v.substring( 5, 6) +
	&apos; &apos;  + v.substring( 6, 7) +
	&apos; &apos;  + v.substring( 7, 8) +
	&apos; &apos;  + v.substring( 8, 9) +
	&apos; &apos;  + v.substring( 9,10) +
	&apos; &apos;  + v.substring(10,11) +
	&apos;  &apos; + v.substring(11);
this._value = v;


}
// OnEndMerge end --------------------------------------------------------
</script>
