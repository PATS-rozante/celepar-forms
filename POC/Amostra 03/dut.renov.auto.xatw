          <script>
// OnEndMerge start ------------------------------------------------------
function OnEndMerge() {
this.cepComDV._value = &apos;/&apos; + this.cepComDV._value + &apos;\\&apos;;
this.nome._value = this.destinatario.nome._value;
this.endereco._value = this.destinatario.endereco._value + &apos; &apos; + this.destinatario.complementoBairro._value;
this.cepMunicipio._value = this.destinatario.cepMunicipio._value;
this.dmatrix._value = this.destinatario.numDATAMATRIX._value;
this.sequencia._value = &apos;Seq.: &apos; + this.destinatario.numSequencia._value + &apos; DMS: &apos; + this.destinatario.numRemessa._value;
this.postagem._value = &apos;POSTADO EM: &apos; + this.dataPostagem._value;
this.CIF._value = this.numCIF._value;
this.espCIF._value = this.numCIF._value;

}
// OnEndMerge end --------------------------------------------------------
</script>
