  <page name="PagDutFrente" visible="yes" size="A4" orientation="Portrait" duplex="left" pagePlace="front" inputTray="tray3">
    <boundingRect left="0.0 cm" top="0.0 cm" width="21.000001 cm" height="29.699999 cm"/>
