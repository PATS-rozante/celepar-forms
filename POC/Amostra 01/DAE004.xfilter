//Custom//
function reverse() {
   var txt = $$GetText();
   var res = '';
	
   for(var i = txt.length-1; i >= 0; i--) {
	res += txt[i];
   }
   $$SetText(res);
}

function setText() {
   var texto = $$GetText()
   if (typeof texto == 'String') {
      texto = [texto];
   }

   var res = [];
   for (var i=0; i < texto.length; i++) {
      var lin = texto[i].substring(0,151).trimRight();

      var txt = lin.substring(1).trim();
      if (! txt)
	   continue;

      if (txt.substring(0,20) == 'Senhor contribuinte:' ||
          txt.substring(0, 6) == 'CNPJ  ' ||
          txt.substring(0, 6) == 'CPF   ' ||
          txt.substring(0,10) == 'Curitiba, ' ||
          txt.substring(0,12) == 'Inspetoria G' ||
          txt.substring(0,28) == 'Inscrição                 Or' ||
          txt.substring(0,14) == 'Div.ativa   TI'
      ) {
         lin = '2' + lin.substring(1);
      } else {
         lin = '1' + lin.substring(1);
      }
      res.push(lin);  

      if (texto[i][0] == '0' || texto[i][0] == '-') {
	   res.push('1 ');		
      }
   }
   $$SetText(res);
}
//Custom//

