//Custom//
function removeCtrls() {
   var arr = [];
   var txt = $$GetText();
   var lin = '  ';
   for(var i=0; i < txt.length; i++) {
      var dupla = false;
	for(var j=0; j < txt[i].length; j++) {
	   var c = txt[i][j];
         if (j == 0 && c == '-') {
            c = ' ';
            dupla = true;
         }
	   if (c <= ' ') {
	      lin += ' ';
         } else {
            lin += c;
         }
      }
      arr.push(lin);
      lin = '';
	if (dupla) arr.push(' ');
   }
   $$SetText(arr);
}
